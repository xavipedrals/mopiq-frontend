# sandbox or production. Required. The app throws if this is missing or any other value.
VITE_PADDLE_ENV=production

# Client-side token. Live tokens start with live_. Sandbox tokens start with test_.
# This is safe to expose in the browser. Never put a Paddle API key (pdl_...) here.
VITE_PADDLE_CLIENT_TOKEN=live_your_client_token

# Server-side only. Set these as Supabase function secrets, never in Vite:
# PADDLE_ENV=production
# PADDLE_API_KEY=pdl_live_apikey_...
# PADDLE_NOTIFICATION_WEBHOOK_SECRET=pdl_ntfset_...
# The RevenueCat v2 secret key needs customer_information:customers:read_write
# so a website purchase can grant the anki_premium entitlement.
# REVENUECAT_SECRET_API_KEY=
# REVENUECAT_PROJECT_ID=

# Optional. When unset, the pricing page uses the live Mopiq Plus price ids.
# Set both in .env.sandbox.local so `vite --mode sandbox` checks out the sandbox catalog.
# VITE_PADDLE_PRICE_MONTH=pri_your_sandbox_monthly_price
# VITE_PADDLE_PRICE_YEAR=pri_your_sandbox_yearly_price

# Enable only after the shared generation migration, worker and recovery sweep are deployed.
VITE_SHARED_AI_GENERATION_ENABLED=false

# Custom study is enabled by default. Set false only to hide it for a rollout.
VITE_CUSTOM_STUDY_ENABLED=true
